{
  "$schema": "node_modules/wrangler/config-schema.json",

  "name": "google-dice-relay",

  "main": "src/index.js",

  "compatibility_date": "2026-09-20",

  "durable_objects": {
    "bindings": [
      {
        "name": "RELAY_ROOM",
        "class_name": "RelayRoom"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "RelayRoom"
      ]
    }
  ]
}
